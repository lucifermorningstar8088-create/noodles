# Noodles uses local llama.cpp inference only. No cloud LLM fallback.
NOODLES_APP_NAME=Noodles
NOODLES_ENVIRONMENT=development
NOODLES_API_HOST=127.0.0.1
NOODLES_API_PORT=8000
NOODLES_LOG_LEVEL=INFO

# Remote access is disabled by default. Use only behind a private TLS VPN/tunnel.
NOODLES_API_ALLOW_REMOTE_BIND=false
# Generate a random secret of at least 32 characters. Never commit the real value.
NOODLES_API_AUTH_TOKEN=

# Local registries. Defaults live under ~/.noodles/.
# Coworkers can inspect/write only inside this configured project folder.
# Example Windows: NOODLES_WORKSPACE_DIR=C:\\Users\\YourName\\Projects\\my-project
# Example macOS/Linux: NOODLES_WORKSPACE_DIR=/home/you/projects/my-project
NOODLES_WORKSPACE_DIR=
NOODLES_WORKSPACE_COMMAND_TIMEOUT_SECONDS=120
