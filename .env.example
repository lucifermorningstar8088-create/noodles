# Noodles runs its LLM locally in-process. No cloud LLM fallback exists.
NOODLES_APP_NAME=Noodles
NOODLES_ENVIRONMENT=development
NOODLES_API_HOST=127.0.0.1
NOODLES_API_PORT=8000
NOODLES_LOG_LEVEL=INFO

# Remote access is disabled by default. If enabled, use ONLY behind a private TLS tunnel/VPN.
# Never expose this API directly to the public internet.
NOODLES_API_ALLOW_REMOTE_BIND=false
# Generate a random secret of at least 32 characters; never commit the real value.
NOODLES_API_AUTH_TOKEN=

# Online tools run from the local Noodles process. Search is opt-in.
NOODLES_WEB_SEARCH_ENABLED=false
# Add 1-10 authorized Tavily keys separated by commas. Keys are never returned by the API.
NOODLES_TAVILY_API_KEYS=
NOODLES_WEB_SEARCH_TIMEOUT_SECONDS=12
