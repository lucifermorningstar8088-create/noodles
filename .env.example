# Local-only API binding. Remote binding is intentionally unsupported in the V1 foundation.
NOODLES_APP_NAME=Noodles
NOODLES_ENVIRONMENT=development
NOODLES_API_HOST=127.0.0.1
NOODLES_API_PORT=8000
NOODLES_LOG_LEVEL=INFO

# Optional online research. Keep disabled until a trusted SearXNG instance is configured.
NOODLES_WEB_SEARCH_ENABLED=false
NOODLES_SEARXNG_URL=http://127.0.0.1:8080
NOODLES_WEB_SEARCH_TIMEOUT_SECONDS=12
